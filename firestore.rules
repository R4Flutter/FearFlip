rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function validScore() {
      return request.resource.data.scoreSeconds is int
          && request.resource.data.scoreSeconds >= 0
          && request.resource.data.scoreSeconds <= 86400;
    }

    function validStage() {
      return request.resource.data.maxStage is int
          && request.resource.data.maxStage >= 1
          && request.resource.data.maxStage <= 9999;
    }

    function validTrophies() {
      return request.resource.data.totalTrophies is int
          && request.resource.data.totalTrophies >= 0
          && request.resource.data.totalTrophies <= 9999999;
    }

    function validMode() {
      return request.resource.data.mode is string
          && request.resource.data.mode.size() > 0
          && request.resource.data.mode.size() <= 40
          && request.resource.data.mode.matches('^[a-z0-9_-]+$');
        }

    function validDisplayName() {
      return request.resource.data.displayName is string
          && request.resource.data.displayName.size() > 0
          && request.resource.data.displayName.size() <= 32;
    }

    function validDeletionRequest(uid) {
      return request.resource.data.keys().hasOnly([
            'uid',
            'email',
            'displayName',
            'isAnonymous',
            'status',
            'source',
            'requestedAt',
            'clientTimestampMs',
          ])
          && request.resource.data.uid == uid
          && request.resource.data.status == 'requested'
          && request.resource.data.source == 'in_app'
          && request.resource.data.isAnonymous is bool
          && request.resource.data.clientTimestampMs is int
          && request.resource.data.requestedAt == request.time;
    }

    match /leaderboards/{mode}/scores/{scoreId} {
      allow read: if true;
      allow write: if false;
    }

    match /leaderboards/{mode}/best/{uid} {
      allow read: if true;
      allow write: if false;
    }

    match /leaderboards/{mode}/profiles/{uid} {
      // Public read for the leaderboard UI. Writes are server-only: the
      // upsertGlobalPanicProgress Cloud Function (admin SDK) is the single
      // chokepoint, so a modified client can no longer inject a stage/trophy
      // value directly.
      allow read: if true;
      allow write: if false;
    }

    match /runs/{uid}/sessions/{sessionId} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn()
          && request.auth.uid == uid
          && validScore()
          && validMode()
          && validDisplayName()
          && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /accountDeletionRequests/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create, update: if isSignedIn()
          && request.auth.uid == uid
          && validDeletionRequest(uid);
      allow delete: if false;
    }
  }
}
